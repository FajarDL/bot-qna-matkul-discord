# Token Bot Discord Anda dari Discord Developer Portal
DISCORD_BOT_TOKEN=masukkan_token_discord_disini

# API Key Google Gemini dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=masukkan_gemini_api_key_disini

# Discord User ID Pemilik Bot (opsional, jika kosong akan menggunakan izin Administrator server)
OWNER_DISCORD_ID=masukkan_user_id_discord_anda
